{
  "rules": {
    "sesi": {
      "$kode": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'rediva@majapop.web.app' && ((!data.exists() && newData.child('guru').val() === auth.uid) || (data.exists() && data.child('guru').val() === auth.uid))",
        ".validate": "$kode.matches(/^[0-9]{4}$/) && newData.hasChildren(['guru', 'aktif'])",
        "guru": { ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())" },
        "aktif": { ".validate": "newData.isBoolean()" },
        "kelas": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "dibuat": { ".validate": "newData.isNumber()" },
        "mode": { ".validate": "newData.val() === 'kelompok' || newData.val() === 'individu'" },
        "menunggu": { ".validate": "newData.isBoolean()" },
        "mulai": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "kelasId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "kelompok": {
          "$id": {
            ".write": "auth != null && root.child('sesi').child($kode).child('aktif').val() === true && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'tim', 'poin', 'langkahKe', 'diperbarui'])",
            "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "tim": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "poin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
            "langkahKe": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
            "absen": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" },
            "diperbarui": { ".validate": "newData.isNumber() && newData.val() <= now" }
          }
        },
        "$lain": { ".validate": false }
      }
    },
    "guru": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.email === 'rediva@majapop.web.app'",
        ".write": "auth != null && auth.uid === $uid && auth.token.email === 'rediva@majapop.web.app'",
        "profil": {
          "nama": { ".validate": "newData.isString() && newData.val().length <= 90" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 160" },
          "sekolah": { ".validate": "newData.isString() && newData.val().length <= 130" },
          "mapel": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "bio": { ".validate": "newData.isString() && newData.val().length <= 450" },
          "$lain": { ".validate": false }
        },
        "materi": {
          "$id": {
            ".validate": "newData.hasChildren(['judul', 'isi'])",
            "judul": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 90" },
            "isi": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000" },
            "dibuat": { ".validate": "newData.isNumber()" },
            "$lain": { ".validate": false }
          }
        },
        "kelas": {
          "$kelas": {
            ".validate": "newData.hasChildren(['nama', 'jenis'])",
            "nama": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "jenis": { ".validate": "newData.val() === 'kelompok' || newData.val() === 'individu'" },
            "catatan": { ".validate": "newData.isString() && newData.val().length <= 450" },
            "dibuat": { ".validate": "newData.isNumber()" },
            "siswa": {
              "$id": {
                ".validate": "newData.hasChildren(['nama'])",
                "nama": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
                "absen": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" },
                "kelompokId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
                "$lain": { ".validate": false }
              }
            },
            "kelompok": {
              "$id": {
                ".validate": "newData.hasChildren(['nama'])",
                "nama": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
                "$lain": { ".validate": false }
              }
            },
            "nilai": {
              "$id": {
                ".validate": "newData.hasChildren(['peserta', 'pesertaId', 'tanggal', 'aktivitas', 'nilai', 'sumber'])",
                "peserta": { ".validate": "newData.val() === 'siswa' || newData.val() === 'kelompok'" },
                "pesertaId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
                "tanggal": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
                "aktivitas": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 90" },
                "nilai": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
                "sumber": { ".validate": "newData.val() === 'manual' || newData.val() === 'sesi'" },
                "sesi": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" },
                "dibuat": { ".validate": "newData.isNumber()" },
                "$lain": { ".validate": false }
              }
            },
            "sesiTersimpan": {
              "$kode": { ".validate": "newData.isBoolean()" }
            },
            "$lain": { ".validate": false }
          }
        },
        "$lain": { ".validate": false }
      }
    }
  }
}
