{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "majapop",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "README.md",
      "database.rules.json",
      "guru-*.png",
      "siswa-*.png",
      "DESAIN*",
      "Album/**",
      "referensi/**",
      "~$*"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
